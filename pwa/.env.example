# Personnel Companion PWA — local configuration.
# Copy to .env.local and fill in. Never commit the filled version.

# NextAuth v5 session signing key. Generate with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"
AUTH_SECRET=<<placeholder>>

# The canonical origin this app is served from. Auth.js v5 refuses to infer it
# from the Host header in production and fails with UntrustedHost. Set it per
# environment rather than enabling trustHost, which would let a forged Host
# header steer the sign-in callback.
AUTH_URL=http://localhost:3100

# The app tier (api/). The browser never calls it directly — only this server does.
API_BASE_URL=http://localhost:3000

# Shared secret for the app tier's internal credential-verification route.
# Must match INTERNAL_API_TOKEN in the repository-root .env.
INTERNAL_API_TOKEN=<<placeholder>>
