# SENTINEL — environment template. Copy to .env and fill real values.
# Secrets are supplied via env ONLY. Never hardcode keys in source.

# --- Database -------------------------------------------------------------
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
# Host-side port (see POSTGRES_HOST_PORT). Containers use db:5432 internally.
POSTGRES_HOST_PORT=55432
DATABASE_URL=postgresql://sentinel:sentinel@localhost:55432/sentinel

# --- Least-privilege DB login used by the request path -------------------
# The app and ML service connect as sentinel_app, which owns nothing and has
# NO table privileges until it SET ROLEs into one of the four app roles.
# Forgetting to SET ROLE therefore fails closed (zero rows), never open.
SENTINEL_APP_PASSWORD=<<generate-a-strong-password>>

# --- Cache / queue --------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Services -------------------------------------------------------------
ML_SERVICE_URL=http://localhost:8000

# --- Crypto ---------------------------------------------------------------
# 32-byte key for field-level AES-256 at rest (Assessment.responses, physiological fields)
AES_KEY=<<32-byte-key-placeholder>>
NEXTAUTH_SECRET=<<placeholder>>

# --- Privacy --------------------------------------------------------------
K_ANONYMITY_THRESHOLD=10

# --- Optional RAG (Section 3.11 — only if 3.1-3.10 are green) -------------
LLM_API_KEY=<<placeholder-only-if-building-rag>>
